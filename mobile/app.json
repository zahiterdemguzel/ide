{
  "expo": {
    "name": "IDE Remote",
    "slug": "ide-remote",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "ide",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d1117",
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#161b22"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan the pairing QR code shown by the desktop IDE.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.ideremote.app",
      "permissions": [
        "CAMERA",
        "REQUEST_INSTALL_PACKAGES",
        "RECORD_AUDIO"
      ],
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-notifications",
      "expo-camera",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Scan the pairing QR code shown by the desktop IDE.",
          "microphonePermission": "Speak a task to start a new Claude session."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach a screenshot or photo to a message you send Claude.",
          "cameraPermission": "Take a photo to attach to a message you send Claude."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Speak a task to start a new Claude session.",
          "speechRecognitionPermission": "Turn the task you speak into text for a new Claude session.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "VoiceSession",
              "label": "New session (voice)",
              "description": "Tap to speak a task; tap again to start a session with it.",
              "minWidth": "110dp",
              "minHeight": "50dp",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "maxResizeHeight": "110dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./src/widget/preview.png"
            }
          ]
        }
      ]
    ]
  }
}
