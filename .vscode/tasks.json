{
  // Tasks surfaced as buttons in the app's top toolbar (right of the launch
  // configs, after the separator). Each one opens an external terminal.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build windows",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Build android",
      "type": "shell",
      "command": "npm run build:android",
      "options": { "cwd": "${workspaceFolder}" }
    }
  ]
}
