{
  "name": "claude-session-editor",
  "version": "0.2.0",
  "description": "Manage multiple interactive Claude CLI sessions with auto status + git staging",
  "author": "zahiterdemguzel",
  "license": "AGPL-3.0-only",
  "main": "src/main/index.js",
  "scripts": {
    "postinstall": "node scripts/fix-electron-signature.js && node scripts/fetch-stt-model.mjs",
    "fetch:stt": "node scripts/fetch-stt-model.mjs",
    "fetch:cad": "node scripts/fetch-cadcraft.mjs",
    "prestart": "node scripts/fetch-cadcraft.mjs --optional && node scripts/build-force-click.js && node scripts/gen-icons.js",
    "start": "electron .",
    "prebuild": "npm run fetch:cad && node scripts/prepare-libredwg.mjs win",
    "build": "electron-builder --win dir --publish never",
    "prebuild:mac": "npm run fetch:cad && node scripts/prepare-libredwg.mjs mac && node scripts/build-force-click.js",
    "build:mac": "electron-builder --mac --publish never",
    "prebuild:linux": "npm run fetch:cad && node scripts/prepare-libredwg.mjs linux",
    "build:linux": "electron-builder --linux AppImage --publish never",
    "build:android": "node scripts/build-android.mjs",
    "gen:mobile": "node scripts/gen-mobile-assets.mjs",
    "test": "node --test --test-reporter=./scripts/test-reporter.js",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.claude.session-editor",
    "productName": "Claude Session Editor",
    "npmRebuild": false,
    "onNodeModuleFile": "./build/on-node-module-file.js",
    "files": [
      "index.html",
      "src/**/*",
      "server/**/*",
      "vendor/cadcraft/cadcraft-web-0.20.1/**/*",
      "assets/**/*",
      "!assets/icon-dev.png",
      ".vscode/**/*",
      "node_modules/**/*",
      "!node_modules/@repomix/tree-sitter-wasms/out/tree-sitter-{c,css,dart,go,php,ruby,rust,solidity,swift,vue}.wasm"
    ],
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**",
      "node_modules/@nut-tree-fork/**",
      "node_modules/node-datachannel/**",
      "node_modules/sherpa-onnx-*/**",
      "node_modules/pyright/**",
      "node_modules/typescript/**",
      "node_modules/@typescript/**",
      "node_modules/typescript-language-server/**"
    ],
    "extraResources": [
      { "from": "resources/cad", "to": "cad" },
      {
        "from": "vendor/stt",
        "to": "stt",
        "filter": [
          "**/*",
          "!.cache/**"
        ]
      }
    ],
    "win": {
      "extraResources": [{ "from": "vendor/libredwg/win/x64/0.14", "to": "libredwg" }],
      "target": "dir",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "extraResources": [
        { "from": "vendor/force-click.node", "to": "force-click.node" },
        { "from": "vendor/libredwg/mac/${arch}/0.14", "to": "libredwg" }
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Voice input dictates what you say into a session terminal. Audio is transcribed on this device and never leaves it."
      }
    },
    "linux": {
      "extraResources": [{ "from": "vendor/libredwg/linux/${arch}/0.14", "to": "libredwg" }],
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Development"
    }
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "11.11.1",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.15.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@repomix/tree-sitter-wasms": "^0.1.17",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "elkjs": "^0.12.0",
    "marked": "^18.1.1",
    "monaco-editor": "^0.57.0",
    "node-datachannel": "^0.33.4",
    "node-llama-cpp": "^3.19.0",
    "paper": "^0.12.18",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "pyright": "^1.1.414",
    "qrcode-generator": "^2.0.4",
    "replicad": "1.2.1",
    "replicad-opencascadejs": "1.2.1",
    "sherpa-onnx-node": "^1.13.4",
    "sql.js": "^1.14.1",
    "three": "^0.185.0",
    "typescript": "^7.0.2",
    "typescript-language-server": "^6.0.2",
    "web-tree-sitter": "^0.26.11",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "node-api-headers": "^1.9.0"
  }
}
